{
  "name": "fitflow-gym",
  "version": "1.1.0",
  "description": "An interactive fitness planning, interval training, and weekly progress experience.",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "test": "npm run test:sw && npm run test:unit && npm run lint && npm run typecheck && npm run build",
    "test:sw": "node --test tests/sw-cache-boundary.test.mjs tests/sw-cache-namespace.test.mjs tests/sw-cache-privacy.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/progress.test.mjs tests/transfer.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "author": "Abdulrahman Hajar",
  "license": "MIT",
  "homepage": "https://fitflow-gym.onrender.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahman-997/fitflow-gym.git"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "keywords": [
    "fitness",
    "nextjs",
    "react",
    "typescript",
    "pwa",
    "responsive-design",
    "accessibility"
  ]
}
